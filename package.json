{
  "name": "letters-in-the-ocean",
  "private": true,
  "version": "0.1.0",
  "description": "A quiet corner of the internet where strangers leave small pieces of kindness for each other.",
  "type": "module",
  "workspaces": [
    "web",
    "worker"
  ],
  "scripts": {
    "dev": "npm run dev --workspace=web",
    "dev:api": "npm run dev --workspace=worker",
    "build": "npm run build --workspace=web",
    "preview": "npm run preview --workspace=web",
    "test": "npm run test --workspace=worker",
    "deploy:api": "npm run deploy --workspace=worker",
    "deploy:web": "npm run deploy --workspace=web",
    "preview:pages": "npm run preview:pages --workspace=web",
    "db:local": "npm run db:local --workspace=worker",
    "db:remote": "npm run db:remote --workspace=worker",
    "lint": "eslint ."
  },
  "engines": {
    "node": ">=22.5.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "eslint": "^9.39.5",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.5",
    "globals": "^17.11.0"
  }
}
